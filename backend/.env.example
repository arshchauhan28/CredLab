# ==========================================
# Secure Coding Assessment Platform - Backend Environment Variables
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS
# DO NOT COMMIT THE ACTUAL .env FILE!
# ==========================================

# Application Settings
PROJECT_NAME="Secure Coding Assessment Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma-separated list or JSON array)
# Allow frontend dev server (Vite runs on port 5173 by default)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_secure_postgres_password"
POSTGRES_DB="secure_coding_db"

# Optional direct connection string override.
# If left empty, it will be assembled automatically from the POSTGRES_* parameters above.
# Note: uses postgresql+psycopg:// dialect
DATABASE_URL="postgresql+psycopg://postgres:your_secure_postgres_password@localhost:5432/secure_coding_db"

# JWT Authentication Configuration
# In production, generate a secure random 32+ character key (e.g., openssl rand -hex 32)
JWT_SECRET_KEY="change-this-in-development-super-secret-key-32chars"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Judge0 Code Execution Configuration (Chunk 5)
JUDGE0_API_URL="https://ce.judge0.com"
# JUDGE0_API_KEY="" # Optional auth token for private Judge0 CE or RapidAPI
JUDGE0_TIMEOUT_SECONDS=15.0
JUDGE0_CPU_TIME_LIMIT=2.0
JUDGE0_MEMORY_LIMIT_KB=128000
EXECUTION_MOCK_MODE=False

# ==========================================
# Cryptographic Completion Certificates (Chunk 10)
# ==========================================
# Issuer identifier shown on digital certificates
CERTIFICATE_ISSUER_NAME="LabOS Sentinel"
# Canonical schema version for payload serialization
CERTIFICATE_SCHEMA_VERSION="1.0"
# Current signing key identifier (used to locate matching verification public key)
CERTIFICATE_KEY_ID="labos-sentinel-dev-2026"
# Private signing key:
# In production, specify a secure path or inject hex private key via protected secret manager:
# CERTIFICATE_PRIVATE_KEY_HEX="<64-hex-char-ed25519-private-seed-or-key>"
# CERTIFICATE_PRIVATE_KEY_PATH="/secrets/ed25519_signing_key.key"
# For local development ONLY, run: python scripts/generate_dev_keys.py
CERTIFICATE_PRIVATE_KEY_PATH=""
CERTIFICATE_PRIVATE_KEY_HEX=""
# In development, set True to allow automatic dev-key generation if missing (NEVER use in production):
CERTIFICATE_DEV_KEY_AUTOGEN=False
# Map of trusted public keys for key rotation & verifying historical certificates (JSON string):
CERTIFICATE_TRUSTED_PUBLIC_KEYS="{}"


# Optional AI-powered hidden test generation (OpenAI-compatible API)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
