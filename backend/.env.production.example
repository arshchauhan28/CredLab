# ==============================================================================
# CredLab Backend - Production Environment Variables
# ==============================================================================
# Copy these values into your Render / Railway / Server secret environment manager.
# NEVER commit the real production .env file to version control.

# Core Application
PROJECT_NAME="CredLab - Secure Coding Platform"
ENVIRONMENT="production"
DEBUG=false
API_V1_STR="/api"
PORT=8000

# CORS Allowed Origins
# Add your deployed production frontend domain (e.g., https://credlab.vercel.app)
BACKEND_CORS_ORIGINS="https://credlab.vercel.app,http://localhost:3000"

# PostgreSQL Database (Neon / Supabase / Render Postgres)
# Ensure the dialect prefix is postgresql+psycopg://
DATABASE_URL="postgresql+psycopg://<username>:<password>@<db-host>:5432/<dbname>?sslmode=require"

# JWT Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY="<generate-random-32-character-secret>"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Code Execution Engine (Judge0)
# Option 1: Official Hosted Judge0 CE (Verified free, 0 INR/month)
JUDGE0_API_URL="https://ce.judge0.com"
# Option 2: RapidAPI Judge0 (Requires RapidAPI account & key)
# JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
# JUDGE0_API_KEY="<your-rapidapi-key>"
# Option 3: Self-hosted Judge0 on Linux VPS
# JUDGE0_API_URL="http://<your-vps-ip>:2358"
# JUDGE0_API_KEY=""

JUDGE0_TIMEOUT_SECONDS=15.0
JUDGE0_CPU_TIME_LIMIT=2.0
JUDGE0_MEMORY_LIMIT_KB=128000
EXECUTION_MOCK_MODE=false

# Digital Certificates (Ed25519)
CERTIFICATE_ISSUER_NAME="CredLab Sentinel"
CERTIFICATE_SCHEMA_VERSION="1.0"
CERTIFICATE_KEY_ID="credlab-prod-2026"
CERTIFICATE_DEV_KEY_AUTOGEN=true

# Optional AI Test Generation / Feedback (Leave blank to disable)
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
